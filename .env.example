# ==============================================================================
# AlphaVision Ecosystem Environment Configuration
# Copy this file to .env and provide your actual API keys and port overrides.
# ==============================================================================

# Google Gemini API Key (Required for Multimodal Vision and Brain Engine)
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Port Configuration
# MateEngine modded desktop runtime API port
MATE_ENGINE_PORT=8787

# SillyTavern UI server port
SILLY_TAVERN_PORT=8000

# AlphaVision Bridge & Subconscious Perception server port
ALPHA_VISION_PORT=5001
